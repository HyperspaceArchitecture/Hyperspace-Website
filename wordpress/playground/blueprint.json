{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "landingPage": "/",
  "login": true,
  "siteOptions": {
    "blogname": "Hyperspace Architecture",
    "blogdescription": "Architecture, planning, interiors and heritage"
  },
  "steps": [
    {
      "step": "installTheme",
      "themeData": {
        "resource": "bundled",
        "path": "/hyperspace-architecture-theme.zip"
      },
      "options": {
        "activate": true,
        "targetFolderName": "hyperspace-architecture"
      }
    }
  ]
}
